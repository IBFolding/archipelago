{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "archipelago",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3210"
      ],
      "port": 3210
    },
    {
      "name": "archipelago-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3211"
      ],
      "port": 3211
    },
    {
      "name": "greenwood",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "/Volumes/CODEX PROJECTS/Greenwood",
        "run",
        "dev"
      ],
      "port": 3211
    },
    {
      "name": "greenwood-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "/Volumes/CODEX PROJECTS/Greenwood/out",
        "-l",
        "3212"
      ],
      "port": 3212
    }
  ]
}